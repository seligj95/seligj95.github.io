---
import GameLayout from "../../layouts/GameLayout.astro";
import QueensBoard from "../../components/QueensBoard.astro";
import DailyLeaderboard from "../../components/DailyLeaderboard.astro";

// The site's own mascot stands in for the crown, same as free play.
const crown = "/images/games/queens-crown.png";
---

<GameLayout
  slug="queens"
  ratio="auto"
  title="Daily Queens"
  tagline="One board a day, the same for everyone."
  tag="Daily"
  instructions="One crown per row, per column and per color, and no two crowns may touch. The clock starts on your first move, and each hint costs 30 seconds."
  backHref="/daily/"
  backLabel="All daily games"
>
  <span slot="status" id="queens-status" aria-live="polite">Not started</span>

  <QueensBoard crown={crown} label="Daily Queens board" showNext={false}>
    <div id="daily-gate" class="gate">
      <div class="gate-panel">
        <p class="gate-day" id="daily-date">Today</p>
        <p class="gate-title" id="daily-difficulty">Dealing today&rsquo;s board&hellip;</p>
        <p class="gate-note" id="daily-blurb">
          Everyone gets this same board today. One go at it, and the clock starts
          when you make your first move.
        </p>
        <button id="daily-start" type="button" disabled>Start</button>
        <p class="gate-small" id="daily-done" hidden></p>
      </div>
    </div>

    <p class="win-time" id="daily-result" slot="win-extra"></p>
    <p class="win-posted" id="daily-posted" slot="win-extra" hidden></p>
    <button id="daily-see-board" type="button" slot="win-extra" hidden>
      See today&rsquo;s times
    </button>
  </QueensBoard>

  <div slot="controls">
    <div class="control-set">
      <span class="control-label" id="daily-clock-label">Time</span>
      <output class="clock" id="daily-clock" aria-labelledby="daily-clock-label">0:00</output>
    </div>

    <div class="control-set">
      <button id="queens-hint" type="button" disabled>Hint &plus;30s</button>
      <button id="queens-undo" type="button" disabled>Undo</button>
    </div>
  </div>

  <div slot="extras">
    <DailyLeaderboard />
  </div>

  <div slot="notes">
    <p>
      Tap a square once to cross it out, again for a crown, again to clear it.
      Drag across the board to cross out a run of squares in one go.
    </p>
    <p>
      The board is built in your browser from today&rsquo;s date, so everyone
      playing today gets exactly the same one, and it is checked to have a single
      solution. Difficulty follows a fixed weekly rhythm &mdash; gentle early in
      the week, hardest at the weekend &mdash; so a slow Saturday is the board,
      not you.
    </p>
    <p>
      Each hint adds 30 seconds to your time, so the cost is visible before you
      take one. Want as many boards as you like instead?
      <a href="/games/queens/">Free play Queens</a> has every size and no clock.
    </p>
  </div>
</GameLayout>

<style is:global>
  /* The gate sits inside the board frame, which belongs to QueensBoard. */
  #daily-gate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-radius: 0.25rem;
    z-index: 2;
  }

  #daily-gate[hidden] {
    display: none;
  }

  #daily-gate .gate-panel {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    max-width: 24ch;
    padding: 1.1rem 1.4rem 1.3rem;
    text-align: center;
    background: var(--bg);
    border: 2px solid var(--text);
    border-radius: 0.5rem;
    box-shadow: 0 12px 30px color-mix(in srgb, var(--text) 18%, transparent);
  }

  #daily-gate .gate-day {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #daily-gate .gate-title {
    margin: 0;
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  #daily-gate .gate-note {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  #daily-gate .gate-small {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  #daily-gate button {
    padding: 0.45rem 1.4rem;
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.15s ease-out;
  }

  #daily-gate button:hover:not(:disabled) {
    opacity: 0.85;
  }

  #daily-gate button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  #daily-clock {
    font-variant-numeric: tabular-nums;
    font-size: 1.25rem;
    font-weight: 600;
    min-width: 5ch;
    text-align: center;
  }

  #daily-result {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  #daily-result:empty {
    display: none;
  }

  /*
    The win panel with the post form in it.
    
    The panel is authored in QueensBoard and the form in DailyLeaderboard, so
    neither carries this page's scoping attribute and these rules have to be
    global. Widths are set here because the panel was built to hold two short
    lines and now holds a form as well.
  */
  #queens-win .win-panel {
    width: min(100%, 21rem);
    /*
      The panel is an auto-sized grid, so without this the name field and its
      button size the column by their natural width and push their way out of
      the panel's own border.
    */
    grid-template-columns: minmax(0, 1fr);
  }

  #queens-win #scores-form {
    justify-items: center;
    width: 100%;
    margin: 0.35rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  #queens-win #scores-form .scores-row,
  #queens-win #scores-form .scores-known {
    width: 100%;
    justify-content: center;
  }

  #queens-win #scores-prompt {
    font-size: 1rem;
  }

  /*
    The panel is a moment, not a page: it has to fit over the board it covers.
    The reassurance about accounts still belongs on the page, so it is hidden
    only while the form is up here — moving the form back down restores it.
  */
  #queens-win #scores-fineprint {
    display: none;
  }

  /*
    On a phone the board is barely 300px square and the panel has to live
    inside it. The note is the one line that can go: the result underneath it
    already carries the time and the hint cost, and the day's size and
    difficulty are printed above the board.
  */
  @media (max-width: 30rem) {
    #queens-win .win-note {
      display: none;
    }
  }

  #daily-posted {
    margin: 0.35rem 0 0;
    font-weight: 600;
  }

  #daily-posted[hidden],
  #daily-see-board[hidden] {
    display: none;
  }

  /* Quieter than the panel's primary button: the board is not the prize. */
  #daily-see-board {
    margin-top: 0.5rem;
    padding: 0.4rem 1.1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  #daily-see-board:hover {
    background: var(--surface);
  }
</style>

<script>
  import { mountQueens } from "../../lib/queens-board";
  import {
    dailyPuzzle,
    DIFFICULTY_LABEL,
    DIFFICULTY_BLURB,
  } from "../../lib/queens-daily";
  import { dayFor, formatDay } from "../../lib/daily";
  import {
    readDone,
    writeDone,
    readName,
    writeName,
    type Done,
  } from "../../lib/daily-progress";
  import {
    clockText as formatClock,
    drawScoreRows,
    fetchScores,
    hintText,
    ordinal,
    submitScore,
    type Score,
  } from "../../lib/daily-scores";

  const gate = document.getElementById("daily-gate") as HTMLDivElement;
  const startButton = document.getElementById("daily-start") as HTMLButtonElement;
  const dateLine = document.getElementById("daily-date") as HTMLParagraphElement;
  const difficultyLine = document.getElementById("daily-difficulty") as HTMLParagraphElement;
  const blurbLine = document.getElementById("daily-blurb") as HTMLParagraphElement;
  const doneLine = document.getElementById("daily-done") as HTMLParagraphElement;
  const clock = document.getElementById("daily-clock") as HTMLOutputElement;
  const result = document.getElementById("daily-result") as HTMLParagraphElement;

  /** What a hint costs, in seconds, charged whether or not it finishes you. */
  const HINT_PENALTY = 30;

  const day = dayFor();

  /** Wall-clock start of the run, or 0 when the clock is not running. */
  let startedAt = 0;
  let penalty = 0;
  let ticking = false;

  function elapsed(): number {
    if (!startedAt) return penalty;
    return Math.floor((Date.now() - startedAt) / 1000) + penalty;
  }

  // The leaderboard formats times the same way, so both sides share one.
  const clockText = formatClock;

  function tick() {
    if (!ticking) return;
    clock.textContent = clockText(elapsed());
    requestAnimationFrame(tick);
  }

  dateLine.textContent = formatDay(day);
  const already = readDone("queens", day);

  // ---------------------------------------------------------------------------
  // The shared board
  //
  // Everything below is optional. The game is complete without it, so a slow or
  // unreachable API only means the section stays hidden.
  // ---------------------------------------------------------------------------

  const scoresPanel = document.getElementById("daily-scores") as HTMLElement;
  const scoresForm = document.getElementById("scores-form") as HTMLFormElement;
  const scoresName = document.getElementById("scores-name") as HTMLInputElement;
  const scoresList = document.getElementById("scores-list") as HTMLOListElement;
  const scoresEmpty = document.getElementById("scores-empty") as HTMLParagraphElement;
  const scoresError = document.getElementById("scores-error") as HTMLParagraphElement;
  const scoresCount = document.getElementById("scores-count") as HTMLParagraphElement;
  const scoresKnown = document.getElementById("scores-known") as HTMLDivElement;
  const scoresAsk = document.getElementById("scores-ask") as HTMLDivElement;
  const postKnown = document.getElementById("scores-post-known") as HTMLButtonElement;
  const renameButton = document.getElementById("scores-rename") as HTMLButtonElement;

  const winOverlay = document.getElementById("queens-win") as HTMLDivElement;
  const winPanel = winOverlay.querySelector(".win-panel") as HTMLDivElement;
  const postedLine = document.getElementById("daily-posted") as HTMLParagraphElement;
  const seeBoard = document.getElementById("daily-see-board") as HTMLButtonElement;

  /** Identifies your own row, so it can be highlighted after a reload. */
  let mine: string | null = null;
  /** Your place, for the rare day busy enough to push you off the first page. */
  let minePlace: number | null = null;

  function drawScores(scores: Score[], total: number) {
    scoresEmpty.hidden = scores.length > 0;
    drawScoreRows(scoresList, scores, mine);

    // Where you stand is more useful than how much of the board is showing, so
    // it wins the one line under the list when both could be said.
    const youIndex = scores.findIndex((score) => score.at === mine);
    const yourPlace = youIndex >= 0 ? youIndex + 1 : minePlace;
    if (yourPlace) {
      scoresCount.hidden = false;
      scoresCount.textContent = `You are ${ordinal(yourPlace)} of ${total} today.`;
    } else {
      scoresCount.hidden = total <= scores.length;
      scoresCount.textContent = `Showing the fastest ${scores.length} of ${total} today.`;
    }
  }

  /** Shows the panel with whatever the API has. False means it never answered. */
  async function showScores(): Promise<boolean> {
    const board = await fetchScores("queens", day);
    if (!board) return false;
    drawScores(board.scores, board.count);
    scoresPanel.hidden = false;
    return true;
  }

  /**
   * Puts the name controls into one of two states: a single button for anyone
   * who has posted before, on this game or any other daily, and a box for
   * everyone else. The stored name lives in the input either way, so submitting
   * reads one field whichever state is showing.
   */
  function fillName() {
    const stored = readName();
    scoresName.value = stored;
    scoresKnown.hidden = !stored;
    scoresAsk.hidden = Boolean(stored);
    if (stored) postKnown.textContent = `Post as ${stored}`;
  }

  renameButton.addEventListener("click", () => {
    scoresKnown.hidden = true;
    scoresAsk.hidden = false;
    scoresName.value = "";
    scoresName.focus();
  });

  /** Sends the overlay away and leaves you looking at the board it covered. */
  function dismissWin() {
    winOverlay.hidden = true;
    // The offer follows you down rather than leaving with the overlay, so
    // dismissing without posting does not cost you the chance.
    if (!scoresForm.hidden && scoresForm.parentElement === winPanel) {
      scoresPanel.insertBefore(scoresForm, scoresEmpty);
    }
    if (!scoresPanel.hidden) {
      scoresPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  seeBoard.addEventListener("click", dismissWin);

  /**
   * Offers to put a finished time on the board.
   *
   * `inWin` moves the form into the win panel so the offer arrives with the
   * congratulations. The node is moved, not copied: there is one form on the
   * page and it goes where it is most useful.
   */
  async function offerToPost(done: Done, inWin: boolean) {
    // Fetch first. If the API is unreachable there is no point offering a form
    // that cannot submit, so the whole section simply never appears.
    if (!(await showScores())) return;

    if (inWin && !winOverlay.hidden) {
      winPanel.insertBefore(scoresForm, postedLine);
    }
    scoresForm.hidden = false;
    fillName();
  }

  scoresForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const name = scoresName.value.trim();
    if (!name) {
      // Only reachable if a stored name was whitespace. Ask properly.
      scoresKnown.hidden = true;
      scoresAsk.hidden = false;
      scoresName.focus();
      return;
    }

    const done = readDone("queens", day);
    if (!done) return;

    const buttons = Array.from(scoresForm.querySelectorAll("button"));
    buttons.forEach((button) => (button.disabled = true));
    scoresError.hidden = true;

    try {
      const posted = await submitScore("queens", day, {
        name,
        seconds: done.seconds,
        hints: done.hints,
      });
      mine = posted.entry.at;
      minePlace = posted.place;
      writeName(name);
      writeDone("queens", { ...done, posted: posted.entry.at }, day);

      const inWin = scoresForm.parentElement === winPanel;
      scoresForm.hidden = true;
      drawScores(posted.scores, posted.count);

      if (inWin) {
        // The panel has just lost the form, so it needs to say what happened.
        postedLine.textContent = `You are ${ordinal(posted.place)} of ${posted.count} today.`;
        postedLine.hidden = false;
      }
    } catch (error) {
      scoresError.textContent =
        error instanceof Error ? error.message : "That did not go through.";
      scoresError.hidden = false;
      buttons.forEach((button) => (button.disabled = false));
    }
  });

  /**
   * Arriving from the daily index, which links straight at the times. The panel
   * is hidden until it has something in it, so the browser cannot honor the
   * hash on its own: fetch first, then go there.
   */
  const wantsScores = location.hash === "#daily-scores";

  function revealScores(shown: boolean) {
    if (shown && wantsScores) scoresPanel.scrollIntoView({ block: "start" });
  }

  // A day already finished either shows the board, or still offers to post.
  // Either way the offer stays below: the win panel belongs to the moment you
  // solved it, not to a later visit.
  if (already) {
    if (already.posted) {
      mine = already.posted;
      void showScores().then(revealScores);
    } else {
      void offerToPost(already, false).then(() => revealScores(!scoresPanel.hidden));
    }
  } else if (wantsScores) {
    void showScores().then(revealScores);
  }

  /**
   * Building the board costs a few hundred milliseconds on the harder days, so
   * doing it inline would hold up the first paint. Let the gate render, then
   * build behind it: by the time anyone has read the panel and reached for
   * Start, the board is waiting.
   */
  requestAnimationFrame(() => {
    setTimeout(() => {
      const today = dailyPuzzle(day);

      const board = mountQueens({
        deal: () => today.puzzle,
        statusFor: ({ placed, size, solved }) => {
          if (solved) return undefined;
          return startedAt || penalty ? `${placed} of ${size} crowns` : "Not started";
        },
        onFirstMove: () => {
          startedAt = Date.now();
          ticking = true;
          tick();
        },
        onHint: () => {
          penalty += HINT_PENALTY;
          clock.textContent = clockText(elapsed());
        },
        onSolved: ({ hintsUsed }) => {
          const seconds = elapsed();
          ticking = false;
          startedAt = 0;
          penalty = seconds;
          clock.textContent = clockText(seconds);
          board.freeze();

          // Only the first finish counts, so a replay after clearing the lock
          // cannot overwrite a time you already put up.
          const done = { seconds, hints: hintsUsed };
          if (!readDone("queens", day)) writeDone("queens", done, day);

          const charged = hintsUsed * HINT_PENALTY;
          result.textContent = charged
            ? `${clockText(seconds)}, including ${clockText(charged)} of hints`
            : clockText(seconds);

          // The overlay covers the board and has nothing to dismiss it on the
          // daily, where there is no next puzzle to move on to.
          seeBoard.hidden = false;

          if (!already) void offerToPost(done, true);
        },
      });

      // Nothing is playable until Start: the gate covers the squares, and
      // freezing covers the hint button, which sits outside it.
      board.freeze();

      const label = DIFFICULTY_LABEL[today.difficulty];
      difficultyLine.textContent = `${label} \u00b7 ${today.puzzle.size}\u00d7${today.puzzle.size}`;
      blurbLine.textContent = DIFFICULTY_BLURB[today.difficulty];
      startButton.disabled = false;

      if (already) {
        // The lock is advisory: it lives in localStorage, so clearing your
        // browser gets you another go. It keeps the day honest, it does not
        // police it.
        const hints = hintText(already.hints);
        doneLine.hidden = false;
        doneLine.textContent = `You finished today in ${clockText(already.seconds)}${
          hints ? ` with ${hints}` : ""
        }. A new board arrives tomorrow.`;
        startButton.textContent = "See your board";
      }

      startButton.addEventListener("click", () => {
        gate.hidden = true;
        // Coming back to a day you already finished lays the answer back out
        // and leaves it locked, so there is something to look at and nothing
        // to gain from a second attempt.
        if (already) {
          clock.textContent = clockText(already.seconds);
          board.reveal();
          return;
        }
        board.thaw();
      });
    }, 0);
  });
</script>
