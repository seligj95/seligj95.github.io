---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameMark from "../../components/GameMark.astro";
import ScoreRows from "../../components/ScoreRows.astro";
import { dailies } from "../../data/dailies";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Daily games — Jordan Selig"
  description="One puzzle a day, the same for everyone: a Queens board against the clock and a Contexto word to find. No account needed."
>
  <section class="daily">
    <header class="intro">
      <h1>Daily</h1>
      <p>
        One puzzle a day, the same one for everyone, and a shared board to put
        your result on. No account, no email, nothing to sign up for &mdash;
        come back tomorrow and there is a new one.
      </p>
      <p class="today" id="daily-today"></p>
    </header>

    <ul class="rows">
      {
        dailies.map((game) => (
          <li class="row" data-daily={game.slug}>
            <a class="head" href={`${base}daily/${game.slug}/`}>
              <span class="mark">
                <GameMark slug={game.slug} />
                <span class="tick" aria-hidden="true">&#10003;</span>
              </span>
              <span class="text">
                <span class="name">
                  {game.title}
                  <span class="dash">&mdash;</span>
                  <span class="tagline">{game.tagline}</span>
                </span>
                <span class="blurb">{game.blurb}</span>
              </span>
              <span class="go" aria-hidden="true">
                &rarr;
              </span>
            </a>

            {/* Both of these need to know what today is, so the script fills them. */}
            <p class="played" data-played hidden />

            <div class="board" data-board hidden>
              <p class="board-head">{game.ranking}</p>
              <ScoreRows id={`board-${game.slug}`} compact />
              <a class="board-all" data-all href={`${base}daily/${game.slug}/#daily-scores`} hidden
                >See the full list &rarr;</a
              >
            </div>
          </li>
        ))
      }
    </ul>

    <p class="aside">
      Prefer to just play? Every one of these is in
      <a href={`${base}games/`}>the arcade</a> too, with nothing keeping score and
      as many goes as you like.
    </p>
  </section>
</BaseLayout>

<style>
  .daily {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .intro {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  .intro p {
    color: var(--text-muted);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .today {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .today:empty {
    display: none;
  }

  ul {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--text);
  }

  .rows li + li {
    border-top: 1px solid var(--border);
  }

  .rows .row {
    padding: 0.55rem 0;
  }

  .rows .head {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    gap: 0 1.1rem;
    padding: 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--text);
    transition: background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rows .head:hover {
    background: var(--surface);
  }

  .rows .mark {
    position: relative;
    color: var(--accent);
    width: 2.75rem;
    height: 2.75rem;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
    A finished game should be obvious from across the room, so the mark itself
    gets the tick rather than only the line of text underneath.
  */
  .tick {
    display: none;
    position: absolute;
    right: -0.3rem;
    bottom: -0.3rem;
    width: 1.15rem;
    height: 1.15rem;
    place-items: center;
    font-size: 0.85rem;
    line-height: 1;
    color: var(--bg);
    background: var(--accent);
    border: 2px solid var(--bg);
    border-radius: 999px;
  }

  .row[data-done] .tick {
    display: grid;
  }

  /* The day is spent either way, but the tick means you finished it. */
  .row[data-gave-up] .tick {
    display: none;
  }

  .rows .head:hover .mark {
    transform: translateY(-2px);
  }

  .text {
    display: grid;
    gap: 0.2rem;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dash,
  .tagline {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .blurb {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .go {
    color: var(--text-muted);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rows .head:hover .go {
    transform: translateX(3px);
  }

  /*
    Everything under the link lines up with the title rather than the mark, so
    a row reads as one thing with its detail hanging off it.
  */
  .played,
  .board {
    margin: 0.35rem 0 0 3.85rem;
  }

  .played {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .played[hidden],
  .board[hidden],
  .board-all[hidden] {
    display: none;
  }

  .board {
    padding-top: 0.5rem;
    /* Narrow, so a name and its time stay visually paired rather than being
       flung to opposite ends of a wide row. */
    max-width: 24rem;
  }

  .board-head {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .board-all {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .board-all:hover {
    text-decoration: underline;
  }

  .aside {
    margin-top: 2.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (max-width: 34rem) {
    .daily {
      padding: 1.5rem 1.1rem;
    }

    .rows .head {
      grid-template-columns: 2.25rem 1fr;
    }

    .rows .mark {
      width: 2.25rem;
      height: 2.25rem;
    }

    .go {
      display: none;
    }

    .played,
    .board {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rows .head,
    .rows .mark,
    .go {
      transition: none;
    }

    .rows .head:hover .mark,
    .rows .head:hover .go {
      transform: none;
    }
  }
</style>

<!--
  The played line is filled in by the script, and Astro only scopes markup it
  can see, so these two live here rather than in the block above.
-->
<style is:global>
  /* A solid badge, not a line of colored text — this is a status, not a note. */
  [data-played] .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    border-radius: 999px;
  }

  /* Spent, not won. A filled accent pill would read as an achievement. */
  [data-played] .badge.quiet {
    color: var(--text-muted);
    background: none;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  [data-played] .played-time {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { dailies } from "../../data/dailies";
  import { dayFor, formatDay } from "../../lib/daily";
  import { readDone } from "../../lib/daily-progress";
  import {
    drawScoreRows,
    fetchScores,
    guessText,
    hintText,
    scoreText,
  } from "../../lib/daily-scores";

  /**
   * This page is built once and then served for months, so today cannot be
   * baked in. Everything dated here is worked out in the browser.
   */
  const day = dayFor();

  const todayLine = document.getElementById("daily-today");
  if (todayLine) todayLine.textContent = formatDay(day);

  /** How many rows a preview shows before deferring to the game's own page. */
  const PREVIEW = 3;

  for (const game of dailies) {
    const row = document.querySelector(`[data-daily="${game.slug}"]`);
    if (!row) continue;

    const played = row.querySelector("[data-played]") as HTMLElement | null;
    const board = row.querySelector("[data-board]") as HTMLElement | null;
    const all = row.querySelector("[data-all]") as HTMLElement | null;
    const list = document.getElementById(`board-${game.slug}`) as HTMLOListElement | null;

    // Have you played it? Answered from this browser alone, and answered at
    // once: it must not wait on a request that may never come back.
    const done = readDone(game.slug, day);
    if (done && played) {
      const hints = hintText(done.hints);

      const badge = document.createElement("span");
      badge.className = done.gaveUp ? "badge quiet" : "badge";
      // A day you were shown the answer to is spent, but it is not a result.
      // The check mark is for finishing, so giving up does not get one.
      badge.textContent = done.gaveUp ? "Gave up" : "\u2713 Played";

      const time = document.createElement("span");
      time.className = "played-time";
      if (done.gaveUp) {
        time.textContent = `after ${guessText(done.score)}`;
      } else {
        const yours = scoreText(done.score, game.scoring, done.elapsed);
        time.textContent = hints ? `${yours} with ${hints}` : yours;
      }

      played.replaceChildren(badge, time);
      played.hidden = false;
      (row as HTMLElement).dataset.done = "true";
      if (done.gaveUp) (row as HTMLElement).dataset.gaveUp = "true";
    }

    // The board is a nicety on top. One that never answers simply stays
    // hidden, the same as on the game's own page.
    if (!board || !list) continue;

    void fetchScores(game.slug, day).then((result) => {
      if (!result || result.count === 0) return;

      drawScoreRows(list, result.scores.slice(0, PREVIEW), done?.posted ?? null, game.scoring);
      board.hidden = false;

      // Always offered, even when every row already fits above, so the way to
      // the full list is somewhere obvious rather than implied by the row.
      if (all) {
        const noun = game.scoring === "time" ? "times" : "scores";
        all.textContent =
          result.count === 1
            ? "See the full list \u2192"
            : `See all ${result.count} ${noun} \u2192`;
        all.hidden = false;
      }
    });
  }
</script>
