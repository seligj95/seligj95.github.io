---
import BaseLayout from "../layouts/BaseLayout.astro";
import ViewCount from "../components/ViewCount.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = all.find((post) => post.data.featured) ?? all[0];
const recent = all.filter((post) => post.id !== featured?.id).slice(0, 4);

const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout
  title="Jordan Selig — Blog"
  description="Personal blog by Jordan Selig."
>
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <p class="greeting">Hey, I'm</p>
        <h1>Jordan<span class="accent-dot">.</span></h1>
        <p class="tagline">Welcome to my corner of the internet. I'm a Product Manager on Azure App Service, writing about app development, AI, agents, and building samples to share along the way.</p>
      </div>
      <img src={`${import.meta.env.BASE_URL}images/logo.png`} alt="Jordan Selig logo" class="hero-logo" />
    </div>
  </section>

  {featured && (
    <section class="featured">
      <h2>Featured</h2>
      <a class="featured-card" href={`${base}blog/${featured.id}/`}>
        {featured.data.heroImage && (
          <img
            class="featured-thumbnail"
            src={featured.data.heroImage}
            alt=""
            loading="eager"
            width="800"
            height="400"
          />
        )}
        <div class="featured-body">
          <h3>
            {featured.data.title}
            {featured.data.externalUrl && (
              <svg class="external-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="External link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
            )}
          </h3>
          <p class="description">{featured.data.description}</p>
          <p class="meta">
            <span class="featured-tag">Featured</span>
            <time datetime={featured.data.pubDate.toISOString()}>
              {formatDate(featured.data.pubDate)}
            </time>
            <span class="sep" aria-hidden="true">&middot;</span>
            <ViewCount
              path={`${base}blog/${featured.id}/`}
              externalUrl={featured.data.externalUrl}
            />
          </p>
        </div>
      </a>
    </section>
  )}

  <section class="posts">
    <h2>Recent Posts</h2>
    <ul>
      {recent.map((post) => (
        <li>
          <a
            href={`${base}blog/${post.id}/`}
          >
            <div class="card-inner">
              {post.data.heroImage && (
                <img
                  class="card-thumbnail"
                  src={post.data.heroImage}
                  alt=""
                  loading="lazy"
                  width="80"
                  height="80"
                />
              )}
              <div class="card-body">
                <div class="card-content">
                  <h3>
                    {post.data.title}
                    {post.data.externalUrl && (
                      <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="External link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
                    )}
                  </h3>
                  <p class="description">{post.data.description}</p>
                </div>
                <p class="meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="sep" aria-hidden="true">&middot;</span>
                  <ViewCount
                    path={`${base}blog/${post.id}/`}
                    externalUrl={post.data.externalUrl}
                  />
                </p>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero,
  .featured,
  .posts {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }
  .featured {
    padding-bottom: 0.5rem;
  }
  .posts {
    padding-top: 1.5rem;
  }
  .hero {
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .hero-text {
    flex: 1;
    min-width: 0;
  }
  .hero-logo {
    width: 15rem;
    height: 15rem;
    object-fit: contain;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .greeting {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-weight: 500;
  }
  .hero h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--text);
    text-wrap: balance;
  }
  .accent-dot {
    color: var(--accent);
  }
  .tagline {
    color: var(--text-muted);
    font-size: 1.175rem;
    max-width: 36rem;
    line-height: 1.6;
  }
  h2 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  li a {
    display: block;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease;
  }
  li:last-child a {
    border-bottom: none;
  }
  li a:hover h3 {
    color: var(--accent);
  }
  .card-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .card-thumbnail {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }
  .card-body {
    flex: 1;
    min-width: 0;
  }
  .card-content {
    margin-bottom: 0.5rem;
  }
  h3 {
    font-size: 1.175rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
    transition: color 0.2s ease;
  }
  .external-icon {
    color: var(--text-muted);
    vertical-align: -0.125em;
    margin-left: 0.25rem;
  }
  /* Featured lead card */
  .featured-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .featured-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 16px var(--accent-subtle);
  }
  .featured-thumbnail {
    display: block;
    width: 100%;
    height: 280px;
    object-fit: cover;
  }
  .featured-body {
    padding: 1.5rem 1.75rem 1.75rem;
  }
  .featured-card h3 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }
  .featured-card .description {
    font-size: 1.05rem;
    line-height: 1.55;
    -webkit-line-clamp: 3;
    margin-bottom: 0.85rem;
  }
  .featured-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .meta .sep {
    opacity: 0.4;
  }
  .description {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2.25rem;
    }
    .hero {
      padding-top: 3rem;
      padding-bottom: 2rem;
    }
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }
    .tagline {
      text-align: left;
    }
    .hero-logo {
      width: 7rem;
      height: 7rem;
    }
    .featured-thumbnail {
      height: 200px;
    }
    .featured-body {
      padding: 1.25rem 1.25rem 1.5rem;
    }
    .featured-card h3 {
      font-size: 1.4rem;
    }
    .card-thumbnail {
      width: 80px;
      height: 80px;
    }
  }
</style>
