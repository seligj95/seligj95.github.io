---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Jordan Selig" description="About Jordan Selig.">
  <section class="about">
    <h1>About Me</h1>
    <div class="bio">
      <p>
        Hi — I'm Jordan. I'm a Product Manager on Azure App Service at Microsoft, where I work on making the cloud a better place for developers to build and deploy their apps.
      </p>
      <p>
        I write about app development, AI, agents, and whatever else I'm tinkering with. I also build samples and share them here so you can try things out for yourself.
      </p>
    </div>

    <div class="grid">
      <div class="card">
        <h2>Interests</h2>
        <ul>
          <li>Azure App Service</li>
          <li>AI &amp; Large Language Models</li>
          <li>Agents &amp; Agentic Systems</li>
          <li>Web Development</li>
          <li>Open Source</li>
          <li>Developer Tools</li>
        </ul>
      </div>
      <div class="card">
        <h2>Find Me</h2>
        <ul class="socials">
          <li>
            <a href="https://github.com/seligj95" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/jordan-selig/" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.028-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}rss.xml`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h-2a7 7 0 0 0-7-7v-2zm0-4a13 13 0 0 1 13 13h-2A11 11 0 0 0 4 9V7zm1.5 9a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></svg>
              <span>RSS Feed</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }
  h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .bio {
    margin-bottom: 2.5rem;
  }
  .bio p {
    line-height: 1.75;
    margin-bottom: 1rem;
    font-size: 1.05rem;
    color: var(--text-muted);
  }
  .bio p:first-child {
    color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .card h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card li {
    font-size: 0.95rem;
  }
  .socials {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .socials a:hover {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: var(--accent);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
