---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const baseUrl = import.meta.env.BASE_URL;

const postsData = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  tags: post.data.tags,
}));
---

<BaseLayout title="Tags — Jordan Selig" description="Browse posts by tag.">
  <section class="tags-page">
    <h1>Tags</h1>
    <div class="tag-list" id="tag-list">
      {allTags.map((tag) => (
        <button
          type="button"
          class="tag"
          data-tag={tag}
        >
          #{tag}
          <span class="count">
            ({posts.filter((p) => p.data.tags.includes(tag)).length})
          </span>
        </button>
      ))}
    </div>
    <div class="filter-bar" id="filter-bar" hidden>
      <span class="filter-summary" id="filter-summary"></span>
      <button type="button" class="clear-btn" id="clear-tags">Clear all</button>
    </div>
    <ul class="post-list" id="post-list">
      {posts.map((post) => (
        <li data-tags={JSON.stringify(post.data.tags)}>
          <a href={`${baseUrl}blog/${post.id}/`}>
            <div class="post-info">
              <span class="title">{post.data.title}</span>
              {post.data.description && (
                <span class="description">{post.data.description}</span>
              )}
            </div>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </a>
        </li>
      ))}
    </ul>
    <p class="no-results" id="no-results" hidden>No posts match the selected tags.</p>
  </section>
</BaseLayout>

<script>
  function initTagFilter() {
    const selectedTags = new Set<string>();
    const tagButtons = document.querySelectorAll<HTMLButtonElement>("#tag-list .tag");
    const postItems = document.querySelectorAll<HTMLLIElement>("#post-list li");
    const filterBar = document.getElementById("filter-bar") as HTMLDivElement;
    const filterSummary = document.getElementById("filter-summary") as HTMLSpanElement;
    const clearBtn = document.getElementById("clear-tags") as HTMLButtonElement;
    const noResults = document.getElementById("no-results") as HTMLParagraphElement;

    function readTagsFromURL() {
      const params = new URLSearchParams(window.location.search);
      const tags = params.get("tags");
      if (tags) {
        tags.split(",").forEach((t) => {
          const trimmed = t.trim();
          if (trimmed) selectedTags.add(trimmed);
        });
      }
    }

    function updateURL() {
      const url = new URL(window.location.href);
      if (selectedTags.size > 0) {
        url.searchParams.set("tags", [...selectedTags].join(","));
      } else {
        url.searchParams.delete("tags");
      }
      window.history.replaceState({}, "", url.toString());
    }

    function render() {
      const hasSelection = selectedTags.size > 0;

      tagButtons.forEach((btn) => {
        const tag = btn.dataset.tag!;
        btn.classList.toggle("active", selectedTags.has(tag));
      });

      filterBar.hidden = !hasSelection;
      if (hasSelection) {
        const tagNames = [...selectedTags].map((t) => `#${t}`).join(", ");
        filterSummary.textContent = `Filtering by: ${tagNames}`;
      }

      let visibleCount = 0;
      postItems.forEach((li) => {
        const postTags: string[] = JSON.parse(li.dataset.tags || "[]");
        const matches = !hasSelection || [...selectedTags].every((t) => postTags.includes(t));
        li.hidden = !matches;
        if (matches) visibleCount++;
      });

      noResults.hidden = visibleCount > 0;

      updateURL();
    }

    tagButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.dataset.tag!;
        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
        } else {
          selectedTags.add(tag);
        }
        render();
      });
    });

    clearBtn.addEventListener("click", () => {
      selectedTags.clear();
      render();
    });

    readTagsFromURL();
    render();
  }

  initTagFilter();
</script>

<style>
  .tags-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tag {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .tag.active:hover {
    opacity: 0.85;
    color: #fff;
  }
  .count {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .tag.active .count {
    color: rgba(255, 255, 255, 0.8);
  }
  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
  }
  .filter-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .clear-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .clear-btn:hover {
    background: var(--accent-subtle);
  }
  .post-list {
    list-style: none;
    margin-top: 0.5rem;
  }
  .post-list li {
    border-bottom: 1px solid var(--border);
  }
  .post-list li:first-child:not([hidden]) {
    border-top: 1px solid var(--border);
  }
  .post-list li a {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 0.5rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 0.375rem;
    transition: background 0.15s ease;
    gap: 1rem;
  }
  .post-list li a:hover {
    background: var(--surface);
  }
  .post-list li a:hover .title {
    color: var(--accent);
  }
  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .title {
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .description {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.125rem;
  }
  .no-results {
    color: var(--text-muted);
    padding: 2rem 0;
    text-align: center;
  }
</style>
