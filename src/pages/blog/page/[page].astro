---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ViewCount from "../../../components/ViewCount.astro";
import BlogSearch from "../../../components/BlogSearch.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 10;
  const allPosts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

  // Generate pages 2 through totalPages (page 1 is index.astro)
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * POSTS_PER_PAGE;
    return {
      params: { page: String(pageNum) },
      props: {
        posts: allPosts.slice(start, start + POSTS_PER_PAGE),
        currentPage: pageNum,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
const hasPrevPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;
const prevUrl =
  currentPage === 2
    ? `${import.meta.env.BASE_URL}blog/`
    : `${import.meta.env.BASE_URL}blog/page/${currentPage - 1}/`;
const nextUrl = `${import.meta.env.BASE_URL}blog/page/${currentPage + 1}/`;
---

<BaseLayout
  title={`Blog — Page ${currentPage} — Jordan Selig`}
  description={`Blog posts, page ${currentPage} of ${totalPages}.`}
>
  <section class="blog-list">
    <h1>All Posts</h1>
    <BlogSearch />
    <div id="blog-default-list">
    <ul>
      {posts.map((post) => (
        <li>
          <a
            href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
          >
            {post.data.heroImage && (
              <img
                class="post-thumbnail"
                src={post.data.heroImage}
                alt=""
                loading="lazy"
                width="80"
                height="80"
              />
            )}
            <div class="post-info">
              <span class="title">
                {post.data.title}
                {post.data.externalUrl && (
                  <svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="External link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
                )}
              </span>
              {post.data.description && (
                <span class="description">{post.data.description}</span>
              )}
            </div>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <ViewCount path={`${import.meta.env.BASE_URL}blog/${post.id}/`} />
            </div>
          </a>
        </li>
      ))}
    </ul>
    <nav class="pagination" aria-label="Blog pagination">
      {hasPrevPage ? (
        <a href={prevUrl}>← Previous</a>
      ) : (
        <span />
      )}
      {hasNextPage ? (
        <a href={nextUrl}>Next →</a>
      ) : (
        <span />
      )}
    </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }
  h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  ul {
    list-style: none;
  }
  li {
    border-bottom: 1px solid var(--border);
  }
  li:first-child {
    border-top: 1px solid var(--border);
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 0.5rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 0.375rem;
    transition: background 0.15s ease;
    gap: 1rem;
  }
  li a:hover {
    background: var(--surface);
  }
  li a:hover .title {
    color: var(--accent);
  }
  .post-thumbnail {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }
  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .title {
    font-weight: 500;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .external-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .description {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  time {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.125rem;
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .pagination a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .pagination a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .post-thumbnail {
      width: 56px;
      height: 56px;
    }
  }
</style>
