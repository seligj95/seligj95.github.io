---
import GameLayout from "../../layouts/GameLayout.astro";
import QueensBoard from "../../components/QueensBoard.astro";

// The site's own mascot stands in for the crown.
const crown = "/images/games/queens-crown.png";
---

<GameLayout slug="queens" ratio="auto">
  <span slot="status" id="queens-status" aria-live="polite">0 of 8 crowns</span>

  <QueensBoard crown={crown} />

  <div slot="controls">
    <div class="control-set">
      <span class="control-label" id="queens-level-label">Size</span>
      <div
        class="control-group"
        role="radiogroup"
        aria-labelledby="queens-level-label"
        style="--columns: 4;"
      >
        <button type="button" role="radio" aria-checked="false" data-level="6">6&times;6</button>
        <button type="button" role="radio" aria-checked="true" data-level="8">8&times;8</button>
        <button type="button" role="radio" aria-checked="false" data-level="9">9&times;9</button>
        <button type="button" role="radio" aria-checked="false" data-level="10">10&times;10</button>
      </div>
    </div>

    <div class="control-set">
      <button id="queens-hint" type="button">Hint</button>
      <button id="queens-undo" type="button" disabled>Undo</button>
    </div>

    <div class="control-set">
      <button id="queens-new" type="button">New puzzle</button>
      <button id="queens-clear" type="button">Clear</button>
    </div>
  </div>

  <div slot="notes">
    <p>
      One crown per row, one per column, one per color &mdash; and no two crowns may
      touch, not even at the corners. Tap a square once to cross it out, again for a
      crown, again to clear it. Drag across the board to cross out a run of squares
      in one go.
    </p>
    <p>
      Every board is generated in your browser and checked to make sure it has
      exactly one solution, so there is always a way through without guessing.
    </p>
    <p>
      Stuck? Hint spotlights the row, column or color where something can still
      be worked out and tells you what holds there &mdash; press it a second time
      and it plays that move for you. Undo walks back a move at a time, and a
      whole drag counts as one.
    </p>
  </div>
</GameLayout>

<script>
  import { mountQueens } from "../../lib/queens-board";

  // Free play: the board deals itself, and the size buttons in the markup do
  // the rest. Everything the daily adds - a clock, a hint charge, one attempt -
  // is absent here by simply not asking for it.
  mountQueens();
</script>
