---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { games } from "../../data/games";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Games — Jordan Selig"
  description="A small arcade of browser games and zen toys built by Jordan Selig — koi pond, falling sand, generative gardens, and more."
>
  <section class="games">
    <h1>Games</h1>
    <p class="subtitle">
      Little browser things I build when I should be doing something else. No accounts,
      no ads, no loading screens &mdash; just canvas and a few hundred lines of JavaScript.
    </p>

    <ul class="game-grid">
      {games.map((game) => (
        <li>
          <a class="game-card" href={`${base}games/${game.slug}/`}>
            <span class="tag">{game.tag}</span>
            <h2>{game.title}</h2>
            <p class="tagline">{game.tagline}</p>
            <p class="blurb">{game.blurb}</p>
            <span class="play">Play &rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="coming-soon">
      Coming eventually: a top-down parking puzzle, snake, brick, and something that
      is legally distinct from Frogger.
    </p>
  </section>
</BaseLayout>

<style>
  .games {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .game-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .game-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .tag {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-subtle);
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  h2 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .tagline {
    font-size: 0.9rem;
    color: var(--text);
  }

  .blurb {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .play {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .coming-soon {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .games {
      padding: 1.5rem 1.25rem 2rem;
    }
  }
</style>
