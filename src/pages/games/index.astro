---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameMark from "../../components/GameMark.astro";
import { games } from "../../data/games";

const base = import.meta.env.BASE_URL;
// One shape for every section: a heading, a note, and a list of rows. The three
// groups differ in what they are, not in how they are presented.
const sections = [
  {
    title: "Puzzles",
    note: "Something to actually solve. Every board is generated fresh in your browser.",
    games: games.filter((game) => game.tag === "puzzle"),
  },
  {
    title: "Arcade",
    note: "The ones you can lose. Reflexes optional, greed encouraged.",
    games: games.filter((game) => game.tag === "arcade"),
  },
  {
    title: "Zen toys",
    note: "No score, no timer, no way to lose. Poke them until you feel better.",
    games: games.filter((game) => game.tag === "zen"),
  },
];
---

<BaseLayout
  title="Games — Jordan Selig"
  description="A small arcade of browser games and zen toys built by Jordan Selig — koi pond, falling sand, generative gardens, jigsaw, and more."
>
  <section class="games">
    <header class="intro">
      <h1>Games</h1>
      <p>
        Little browser things I build when I should be doing something else. No accounts,
        no ads, no loading screens &mdash; just canvas and a few hundred lines of
        JavaScript, running entirely on your machine.
      </p>
    </header>

    {
      sections.map((section) => (
        <section class="group">
          <div class="group-head">
            <h2>{section.title}</h2>
            <p>{section.note}</p>
          </div>

          <ul class="rows">
            {section.games.map((game) => (
              <li>
                <a href={`${base}games/${game.slug}/`}>
                  <span class="mark">
                    <GameMark slug={game.slug} />
                  </span>
                  <span class="text">
                    <span class="name">
                      {game.title}
                      <span class="dash">&mdash;</span>
                      <span class="tagline">{game.tagline}</span>
                    </span>
                    <span class="blurb">{game.blurb}</span>
                  </span>
                  <span class="go" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .games {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .intro {
    max-width: 38rem;
    margin-bottom: 3.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  .intro p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .group + .group {
    margin-top: 4rem;
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--text);
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .group-head p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  /* Puzzles read as an index, not a wall of cards. */
  .rows li + li {
    border-top: 1px solid var(--border);
  }

  .rows a {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    gap: 0 1.1rem;
    padding: 1.15rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--text);
    transition: background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rows .mark {
    color: var(--accent);
    width: 2.75rem;
    height: 2.75rem;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .dash {
    color: var(--border);
    margin-inline: 0.35rem;
  }

  .rows .tagline {
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .blurb {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .go {
    color: var(--accent);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity 0.25s ease-out,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rows a:hover,
  .rows a:focus-visible {
    background: var(--accent-subtle);
  }

  .rows a:hover .go,
  .rows a:focus-visible .go {
    opacity: 1;
    transform: none;
  }

  .rows a:hover .mark {
    transform: rotate(-6deg) scale(1.06);
  }

  @media (max-width: 30rem) {
    .games {
      padding: 1.5rem 1.25rem 2rem;
    }

    .rows a {
      grid-template-columns: 2.25rem 1fr;
      gap: 0 0.9rem;
    }

    .rows .mark {
      width: 2.25rem;
      height: 2.25rem;
    }

    .go,
    .dash {
      display: none;
    }

    .rows .tagline {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rows a,
    .rows .mark,
    .go {
      transition-duration: 0.01ms;
    }

    .rows a:hover .mark {
      transform: none;
    }
  }
</style>
