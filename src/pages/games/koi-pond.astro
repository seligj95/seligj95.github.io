---
import GameLayout from "../../layouts/GameLayout.astro";
import KoiPond from "../../components/KoiPond.astro";
---

<GameLayout slug="koi-pond">
  <span slot="status" id="pond-feed-count" aria-live="polite">0 snacks served</span>

  <KoiPond />

  <div slot="notes">
    <p>
      The koi wander on their own with a bit of separation steering so they don't
      pile up. Every fish goes after the nearest snack no one closer has already
      claimed, so dumping in a whole handful just gives them a queue to work
      through. Your snack count lives in this browser only.
    </p>
  </div>
</GameLayout>
