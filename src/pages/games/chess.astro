---
import GameLayout from "../../layouts/GameLayout.astro";
import ChessBoard from "../../components/ChessBoard.astro";
---

<GameLayout slug="chess" ratio="auto">
  <span slot="status" id="chess-status" aria-live="polite">White to move</span>

  <ChessBoard />

  <div slot="controls">
    <div class="control-set">
      <span class="control-label" id="chess-clock-label">Time</span>
      <output class="clock" id="chess-clock" aria-labelledby="chess-clock-label">0:00</output>
    </div>

    <div class="control-set">
      <span class="control-label" id="chess-attempts-label">Moves</span>
      <output class="clock" id="chess-attempts" aria-labelledby="chess-attempts-label">0</output>
    </div>

    <div class="control-set">
      <button id="chess-new" type="button">New puzzle</button>
      <button id="chess-reset" type="button">Reset</button>
    </div>
  </div>

  <div slot="notes">
    <p>
      White to move and mate. Tap a piece to see where it can legally go, then
      tap a highlighted square to move it there &mdash; or tap the piece again
      to put it back down. Every move is checked against real chess rules by
      <a href="https://github.com/jhlywa/chess.js">chess.js</a>, so anything
      you try that is not actually legal is simply refused.
    </p>
    <p>
      A move that <em>is</em> legal but is not the one the puzzle is looking
      for flashes on the board, then the position is put straight back &mdash;
      and it still counts against your move total, the same as a right one would.
      That is what the counter is for: it is not just moves played, it is
      moves attempted. Once you find the right move, the defense replies on
      its own, and it keeps going until you deliver mate.
    </p>
    <p>
      Reset puts the position back to the start of the puzzle without losing
      your move count or your time &mdash; it undoes the board, not the
      attempt. New puzzle deals a fresh position and starts the count over.
    </p>
    <p>
      Keyboard: arrow keys move focus around the board, Enter or Space picks
      up or drops a piece, and Escape clears whatever you had selected.
    </p>
  </div>
</GameLayout>

<style is:global>
  #chess-clock,
  #chess-attempts {
    font-variant-numeric: tabular-nums;
    font-size: 1.25rem;
    font-weight: 600;
    min-width: 3ch;
    text-align: center;
  }
</style>

<script>
  import { mountChess } from "../../lib/chess-board";
  import { randomPuzzle } from "../../data/chess-puzzles";
  import { clockText } from "../../lib/daily-scores";

  const clock = document.getElementById("chess-clock") as HTMLOutputElement;
  const attemptsOut = document.getElementById("chess-attempts") as HTMLOutputElement;
  const newButton = document.getElementById("chess-new") as HTMLButtonElement;
  const resetButton = document.getElementById("chess-reset") as HTMLButtonElement;

  /** Wall-clock start of the run, or 0 when the clock is not running. */
  let startedAt = 0;
  let ticking = false;
  /** The puzzle just dealt, so "New puzzle" never repeats it immediately. */
  let lastId: string | undefined;

  function elapsedSeconds(): number {
    return startedAt ? Math.floor((Date.now() - startedAt) / 1000) : 0;
  }

  function tick() {
    if (!ticking) return;
    clock.textContent = clockText(elapsedSeconds());
    requestAnimationFrame(tick);
  }

  const board = mountChess({
    deal: () => {
      const puzzle = randomPuzzle(lastId);
      lastId = puzzle.id;
      return puzzle;
    },
    onFirstMove: () => {
      startedAt = Date.now();
      ticking = true;
      tick();
    },
    onAttempt: ({ attempts }) => {
      attemptsOut.textContent = String(attempts);
    },
    onSolved: () => {
      ticking = false;
      clock.textContent = clockText(elapsedSeconds());
    },
    onNext: fresh,
  });

  /** A wholly new puzzle: the count and clock start over with it. */
  function fresh() {
    ticking = false;
    startedAt = 0;
    clock.textContent = clockText(0);
    attemptsOut.textContent = "0";
    board.build();
  }

  newButton.addEventListener("click", fresh);
  // Puts the position back, on purpose, without touching the count or clock:
  // resetting the board is not the same as forgiving the attempts it took.
  resetButton.addEventListener("click", () => board.resetPosition());

  fresh();
</script>
