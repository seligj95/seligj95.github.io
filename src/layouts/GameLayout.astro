---
import BaseLayout from "./BaseLayout.astro";
import { gameBySlug } from "../data/games";

interface Props {
  slug: string;
  /** Aspect ratio of the play area, e.g. "16 / 9". */
  ratio?: string;
}

const { slug, ratio = "16 / 9" } = Astro.props;
const game = gameBySlug(slug);
const base = import.meta.env.BASE_URL;
// Phones normally squash the stage to 4/3, but content-sized stages (board
// games) must keep growing or they get clipped.
const stageStyle = `--stage-ratio: ${ratio}; --stage-ratio-narrow: ${
  ratio === "auto" ? "auto" : "4 / 3"
};`;
---

<BaseLayout
  title={`${game.title} — Games — Jordan Selig`}
  description={game.blurb}
>
  <article class="game">
    <a class="back" href={`${base}games/`}>&larr; All games</a>

    <header class="game-header">
      <div>
        <h1>{game.title}</h1>
        <p class="tagline">{game.tagline}</p>
      </div>
      <span class="tag">{game.tag}</span>
    </header>

    <div class="game-bar">
      <p class="instructions" id="game-instructions">{game.instructions}</p>
      <div class="game-status"><slot name="status" /></div>
    </div>

    <div class="game-stage" style={stageStyle} data-pagefind-ignore>
      <slot />
    </div>

    <div class="game-controls" data-pagefind-ignore><slot name="controls" /></div>

    <div class="game-notes"><slot name="notes" /></div>
  </article>
</BaseLayout>

<style>
  .game {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .game-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .tag {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .game-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 1.75rem 0 0.75rem;
  }

  .instructions {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .game-status {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .game-stage {
    position: relative;
    aspect-ratio: var(--stage-ratio, 16 / 9);
    min-height: 280px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .game-controls:empty,
  .game-notes:empty {
    display: none;
  }

  .game-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .game-notes {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  :global([data-theme="geocities"]) .game-stage {
    border: 3px ridge #00ffff;
    box-shadow: 0 0 16px #ff00ff, inset 0 0 18px #00ffff;
  }

  @media (max-width: 640px) {
    .game {
      padding: 1.5rem 1.25rem 2rem;
    }

    .game-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    /* Controls span the full width on phones so each row of buttons can
       divide it evenly instead of huddling on the left. */
    .game-controls {
      align-items: stretch;
      gap: 0.75rem;
    }

    .game-stage {
      aspect-ratio: var(--stage-ratio-narrow, 4 / 3);
      min-height: 260px;
    }
  }
</style>

<style is:global>
  /* Shared control styling for every game page. */

  /* A labelled cluster of related controls. Sets wrap as a unit so buttons
     never scatter into an arbitrary ragged grid. */
  .game-controls .control-set {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .game-controls .control-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Radiogroups render as a segmented control: one object, one choice.
     The 1px gaps let the group's own background show through as dividers,
     which keeps the seams correct even when the segments wrap. */
  .game-controls .control-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--border);
    overflow: hidden;
  }

  .game-controls .control-group button {
    border: 0;
    border-radius: 0;
    background: var(--surface);
  }

  .game-controls button,
  .game-controls .swatch {
    font: inherit;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    min-height: 36px;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .game-controls button:hover,
  .game-controls .swatch:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .game-controls .control-group button:hover {
    background: var(--accent-subtle);
  }

  .game-controls [aria-pressed="true"],
  .game-controls [aria-checked="true"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .game-controls .swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .game-controls .swatch::before {
    content: "";
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.25rem;
    background: var(--swatch, currentColor);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  @media (pointer: coarse) {
    .game-controls button,
    .game-controls .swatch {
      min-height: 44px;
    }
  }

  @media (max-width: 640px) {
    /* Phones get full-width rows: the label breaks onto its own line and the
       controls below it share the width evenly, so every target is thumb-sized
       instead of a small pill floating in dead space. */
    .game-controls .control-set {
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
    }

    .game-controls .control-label {
      flex: 0 0 100%;
    }

    .game-controls .control-set > button {
      flex: 1 1 0;
    }

    .game-controls .control-group {
      flex: 1 0 100%;
    }

    .game-controls .control-group button {
      /* Even columns so a set never leaves one orphan stretched across the
         whole width. Groups can override --columns for their own count;
         five materials at 3-up land as a tidy 3 + 2. */
      flex: 1 1 calc(100% / var(--columns, 3) - 1px);
      padding-inline: 0.4rem;
    }
  }
</style>
