---
import BaseLayout from "./BaseLayout.astro";
import { gameBySlug } from "../data/games";

interface Props {
  slug: string;
  /** Aspect ratio of the play area, e.g. "16 / 9". */
  ratio?: string;
  /** Overrides for pages that are not a game's own page, like the daily. */
  title?: string;
  tagline?: string;
  tag?: string;
  instructions?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  slug,
  ratio = "16 / 9",
  title,
  tagline,
  tag,
  instructions,
  backHref,
  backLabel,
} = Astro.props;
const game = gameBySlug(slug);
const base = import.meta.env.BASE_URL;
// Phones normally squash the stage to 4/3, but content-sized stages (board
// games) must keep growing or they get clipped.
const stageStyle = `--stage-ratio: ${ratio}; --stage-ratio-narrow: ${
  ratio === "auto" ? "auto" : "4 / 3"
};`;
const heading = title ?? game.title;
const subtitle = tagline ?? game.tagline;
const badge = tag ?? game.tag;
const howTo = instructions ?? game.instructions;
// Keep the registry's blurb for a game's own page - it is written for search
// results - and fall back to the tagline only when a page overrides the title.
const description = title ? subtitle : game.blurb;
---

<BaseLayout
  title={`${heading} — Games — Jordan Selig`}
  description={description}
>
  <article class="game">
    <a class="back" href={backHref ?? `${base}games/`}>
      &larr; {backLabel ?? "All games"}
    </a>

    <header class="game-header">
      <div>
        <h1>{heading}</h1>
        <p class="tagline">{subtitle}</p>
      </div>
      <span class="tag">{badge}</span>
    </header>

    <div class="game-bar">
      <p class="instructions" id="game-instructions">{howTo}</p>
      <div class="game-status"><slot name="status" /></div>
    </div>

    <div class="game-stage" style={stageStyle} data-pagefind-ignore>
      <slot />
    </div>

    <div class="game-controls" data-pagefind-ignore><slot name="controls" /></div>

    <div class="game-notes"><slot name="notes" /></div>
  </article>
</BaseLayout>

<script>
  /*
   * iOS starts its own selection and callout gestures partway through a drag,
   * especially once a finger leaves the board and lands on the prose below it.
   * A play surface that declares touch-action: none has already claimed the
   * gesture, so for as long as one is running, hold the page's own text
   * handling off. Only touchmove is cancelled: cancelling touchstart would also
   * cancel the tap that games like Queens rely on.
   */
  const root = document.documentElement;

  function owned(target: EventTarget | null): boolean {
    return (
      target instanceof Element &&
      target.closest(".game-stage") !== null &&
      getComputedStyle(target).touchAction === "none"
    );
  }

  document.addEventListener("pointerdown", (event) => {
    if (owned(event.target)) root.dataset.gesture = "true";
  });

  function release() {
    delete root.dataset.gesture;
  }

  document.addEventListener("pointerup", release);
  document.addEventListener("pointercancel", release);
  window.addEventListener("blur", release);

  document.addEventListener(
    "touchmove",
    (event) => {
      // Touch events stay retargeted to where the finger landed, so this asks
      // whether the gesture began on a play surface, not where it is now.
      if (owned(event.target)) event.preventDefault();
    },
    { passive: false }
  );
</script>

<style>
  .game {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .game-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .tag {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .game-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    margin: 1.75rem 0 0.75rem;
  }

  .instructions {
    flex: 1 1 auto;
    /* Reserve enough width that a long status wraps to its own line instead of
       squeezing this into a column of single words. */
    min-width: min(20rem, 100%);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Most statuses are a few words and sit at the end of the instructions line.
     Queens' hints are whole sentences, so let a long one take its own line
     rather than squeeze the instructions into a column of single words. */
  .game-status {
    flex: 0 1 auto;
    min-width: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }

  .game-stage {
    position: relative;
    aspect-ratio: var(--stage-ratio, 16 / 9);
    min-height: 280px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
    /* Nothing in a play area is text you'd want to copy, and on phones a
       press-and-hold otherwise trips the browser's select-and-highlight
       gesture in the middle of a game. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .game-controls:empty,
  .game-notes:empty {
    display: none;
  }

  .game-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.35rem;
    /* Buttons get pressed and held mid-game, which on iOS otherwise trips the
       select-and-copy callout on their labels instead of just firing them. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .game-notes {
    margin-top: 2rem;
    /* Same measure the blog prose uses: the board can be as wide as it likes,
       but the paragraphs under it still have to be readable. */
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* The global reset strips paragraph margins and only .prose puts them back,
     so without this every note runs into the next as one gray slab. */
  .game-notes :global(p + p),
  .game-notes :global(ul),
  .game-notes :global(ol) {
    margin-top: 1rem;
  }

  .game-notes :global(li + li) {
    margin-top: 0.35rem;
  }

  .game-notes :global(ul),
  .game-notes :global(ol) {
    padding-left: 1.25rem;
  }

  :global([data-theme="geocities"]) .game-stage {
    border: 3px ridge #00ffff;
    box-shadow: 0 0 16px #ff00ff, inset 0 0 18px #00ffff;
  }

  @media (max-width: 640px) {
    .game {
      padding: 1.5rem 1.25rem 2rem;
    }

    .game-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    /* Controls span the full width on phones so each row of buttons can
       divide it evenly instead of huddling on the left. */
    .game-controls {
      align-items: stretch;
      gap: 0.75rem;
    }

    .game-stage {
      aspect-ratio: var(--stage-ratio-narrow, 4 / 3);
      min-height: 260px;
    }
  }
</style>

<style is:global>
  /* Shared control styling for every game page. */

  /* While a play surface owns a drag, nothing on the page is selectable, so a
     finger that wanders off the board cannot start highlighting the prose
     underneath it mid-game. */
  html[data-gesture] {
    user-select: none;
    -webkit-user-select: none;
  }

  /* A labeled cluster of related controls. Sets wrap as a unit so buttons
     never scatter into an arbitrary ragged grid. */
  .game-controls .control-set {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .game-controls .control-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Radiogroups render as a segmented control: one object, one choice.
     The 1px gaps let the group's own background show through as dividers,
     which keeps the seams correct even when the segments wrap. */
  .game-controls .control-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--border);
    overflow: hidden;
  }

  .game-controls .control-group button {
    border: 0;
    border-radius: 0;
    background: var(--surface);
  }

  .game-controls button,
  .game-controls .swatch {
    font: inherit;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    min-height: 36px;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    /* Repeated taps on a control are the game being played, not a request to
       double-tap-zoom the page. */
    touch-action: manipulation;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .game-controls button:hover,
  .game-controls .swatch:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .game-controls button:disabled,
  .game-controls button:disabled:hover {
    opacity: 0.45;
    cursor: not-allowed;
    color: var(--text-muted);
    border-color: var(--border);
  }

  .game-controls .control-group button:hover {
    background: var(--accent-subtle);
  }

  .game-controls [aria-pressed="true"],
  .game-controls [aria-checked="true"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  .game-controls .swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .game-controls .swatch::before {
    content: "";
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.25rem;
    background: var(--swatch, currentColor);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  @media (pointer: coarse) {
    .game-controls button,
    .game-controls .swatch {
      min-height: 44px;
    }
  }

  @media (max-width: 640px) {
    /* Phones get full-width rows: the label breaks onto its own line and the
       controls below it share the width evenly, so every target is thumb-sized
       instead of a small pill floating in dead space. */
    .game-controls .control-set {
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
    }

    .game-controls .control-label {
      flex: 0 0 100%;
    }

    .game-controls .control-set > button {
      flex: 1 1 0;
    }

    .game-controls .control-group {
      flex: 1 0 100%;
    }

    .game-controls .control-group button {
      /* Even columns so a set never leaves one orphan stretched across the
         whole width. Groups can override --columns for their own count;
         five materials at 3-up land as a tidy 3 + 2. */
      flex: 1 1 calc(100% / var(--columns, 3) - 1px);
      padding-inline: 0.4rem;
    }
  }
</style>
