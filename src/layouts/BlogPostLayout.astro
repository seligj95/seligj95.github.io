---
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import ShareButtons from "../components/ShareButtons.astro";
import ViewCount from "../components/ViewCount.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, externalUrl } = post.data;
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Extract domain for external post attribution
const externalDomain = externalUrl ? new URL(externalUrl).hostname.replace(/^www\./, "") : null;

// Reading time estimate
const body = post.body ?? "";
const words = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 225));
---

<BaseLayout title={title} description={description}>
  <!-- JSON-LD Structured Data for blog posts (Article schema) -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      author: {
        "@type": "Person",
        name: "Jordan Selig",
      },
      keywords: tags.join(", "),
      url: shareUrl,
    })}
  />
  <article>
    <header class="post-header">
      <div class="post-meta" data-pagefind-ignore>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>{readingTime} min read</span>
        <span class="sep" aria-hidden="true">&middot;</span>
        <ViewCount path={Astro.url.pathname} />
        {updatedDate && (
          <span class="updated">
            &middot; Updated <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </span>
        )}
      </div>
      <h1 data-pagefind-meta="title">{title}</h1>
      <span data-pagefind-meta={`description:${description}`} style="display:none;"></span>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag: string) => (
            <a href={`${import.meta.env.BASE_URL}tags/${tag}/`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    {heroImage && (
      <img class="hero-image" src={heroImage} alt={title} />
    )}

    {externalUrl && (
      <aside class="external-banner">
        <p>
          This post was originally published on <strong>{externalDomain}</strong>.
          <a href={externalUrl} target="_blank" rel="noopener noreferrer">
            Read the full article
            <svg class="external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="External link"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
          </a>
        </p>
      </aside>
    )}

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    <ShareButtons title={title} url={shareUrl} />
    <Comments />
  </article>

  <div class="lightbox-overlay" id="lightbox">
    <img id="lightbox-img" src="" alt="" />
  </div>
</BaseLayout>

<style>
  article {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }
  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .hero-image {
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
  }
  .external-banner {
    border: 1px solid var(--border);
    background: var(--accent-subtle);
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.925rem;
    line-height: 1.6;
  }
  .external-banner p {
    margin: 0;
    color: var(--text);
  }
  .external-banner a {
    font-weight: 500;
    white-space: nowrap;
  }
  .external-banner .external-icon {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.2rem;
    position: relative;
    top: -1px;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }
  .post-meta {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .sep {
    opacity: 0.4;
  }
  .updated {
    font-style: italic;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.8rem;
    color: var(--accent);
    text-decoration: none;
    background: var(--accent-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-weight: 500;
    transition: background 0.15s ease;
  }
  .tag:hover {
    background: var(--accent);
    color: #fff;
  }
  .prose {
    line-height: 1.8;
    max-width: 65ch;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(pre) {
    padding: 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .prose :global(code) {
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.375rem;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  /* Table styling */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.925rem;
  }
  .prose :global(thead) {
    border-bottom: 2px solid var(--border);
  }
  .prose :global(th) {
    text-align: left;
    padding: 0.625rem 1rem;
    font-weight: 600;
    color: var(--text);
  }
  .prose :global(td) {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: none;
  }
  /* Image + caption: when img and em are in the same <p> */
  .prose :global(p:has(> img)) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .prose :global(p:has(> img) > em) {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: center;
    display: block;
  }
  /* When img is the only child (separate caption paragraph below) */
  .prose :global(p:has(> img:only-child)) {
    margin-bottom: 0.25rem;
  }
  .prose :global(p:has(> img:only-child) + p:has(> em:only-child)) {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-align: center;
  }
  /* Lightbox overlay */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .lightbox-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 0.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }
  .prose :global(img) {
    cursor: zoom-in;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  const overlay = document.getElementById('lightbox') as HTMLDivElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

  document.querySelectorAll('.prose img').forEach((img) => {
    img.addEventListener('click', () => {
      const src = (img as HTMLImageElement).src;
      const alt = (img as HTMLImageElement).alt;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      overlay.classList.add('active');
    });
  });

  overlay.addEventListener('click', () => {
    overlay.classList.remove('active');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') overlay.classList.remove('active');
  });
</script>
