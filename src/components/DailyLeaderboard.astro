---
/**
 * The shared board for a daily game, and the offer to add your own result.
 *
 * Hidden until there is something to show: either you have finished and can
 * post, or there are already results up. If the API cannot be reached it stays
 * hidden entirely — the game is complete without it.
 *
 * The wording follows what the game is ranked by, because "add your time" is
 * wrong on a board that counts guesses and "add your score" is vague on one
 * that is plainly a race.
 *
 * The form is authored here but does not necessarily stay here. On a fresh
 * solve the page moves the node into the win panel, so the offer arrives with
 * the congratulations rather than somewhere below the fold. It is moved rather
 * than copied so there is only ever one form, one set of listeners and one
 * place for its styles.
 */
import ScoreRows from "./ScoreRows.astro";
import type { Scoring } from "../lib/daily-scores";

interface Props {
  scoring?: Scoring;
}

const { scoring = "time" } = Astro.props;

const words = {
  time: { heading: "Today’s times", prompt: "Add your time", thing: "a time" },
  guesses: { heading: "Today’s scores", prompt: "Add your score", thing: "a score" },
}[scoring];
---

<section id="daily-scores" class="scores" hidden data-pagefind-ignore>
  <h2>{words.heading}</h2>

  <form id="scores-form" class="scores-form" hidden>
    <p class="scores-prompt" id="scores-prompt">{words.prompt}</p>

    <!-- Shown to anyone who has posted before, here or on another daily. -->
    <div class="scores-known" id="scores-known" hidden>
      <button type="submit" id="scores-post-known"></button>
      <button type="button" class="scores-link" id="scores-rename">Not you?</button>
    </div>

    <div class="scores-row" id="scores-ask">
      <input
        id="scores-name"
        name="name"
        type="text"
        maxlength="20"
        autocomplete="nickname"
        placeholder="Your name"
        required
      />
      <button type="submit">Post it</button>
    </div>

    <p class="scores-small" id="scores-fineprint">
      No account, no email. Just a name so you can spot yourself in the list.
    </p>
    <p class="scores-error" id="scores-error" role="alert" hidden></p>
  </form>

  <p class="scores-empty" id="scores-empty" hidden>
    Nobody has posted {words.thing} today. Be the first.
  </p>

  <ScoreRows id="scores-list" />

  <p class="scores-small" id="scores-count" hidden></p>
</section>

<style>
  .scores {
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.4rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    /* Arrived at by #daily-scores from the daily index; the site header is
       sticky, so leave it room rather than landing underneath it. */
    scroll-margin-top: 5.5rem;
  }

  .scores[hidden] {
    display: none;
  }

  .scores h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .scores-form {
    display: grid;
    /* The name field's natural width is wider than a phone-sized panel, and an
       auto grid column would let it push out rather than shrink. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    margin: 0 0 1rem;
  }

  .scores-form[hidden] {
    display: none;
  }

  .scores-prompt {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .scores-row,
  .scores-known {
    display: flex;
    gap: 0.5rem;
  }

  .scores-row[hidden],
  .scores-known[hidden] {
    display: none;
  }

  .scores-known {
    align-items: center;
    flex-wrap: wrap;
  }

  .scores-row input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.45rem 0.7rem;
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .scores-row input:focus-visible,
  .scores-form button:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 1px;
  }

  .scores-row button,
  .scores-known button[type="submit"] {
    flex: 0 0 auto;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .scores-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* A button that reads as a link: changing your name is a side road. */
  .scores-link {
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .scores-link:hover {
    color: var(--text);
  }

  .scores-small {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .scores-error {
    margin: 0;
    color: var(--danger);
    font-size: 0.85rem;
  }

  .scores-error[hidden] {
    display: none;
  }

  .scores-empty {
    margin: 0;
    color: var(--text-muted);
  }

  .scores-empty[hidden] {
    display: none;
  }

  #scores-count {
    margin-top: 0.6rem;
  }

  #scores-count[hidden] {
    display: none;
  }
</style>
