---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<svg
  class="game-mark"
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    slug === "koi-pond" && (
      <>
        <circle cx="20" cy="20" r="14" stroke-opacity="0.35" />
        <circle cx="20" cy="20" r="8.5" stroke-opacity="0.2" />
        <path d="M11 22c4-6 11-7 15-2-3 5-11 6-15 2Z" />
        <path d="M26 20l5-3v6l-5-3Z" />
        <circle cx="15" cy="20.5" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === "sand" && (
      <>
        <path d="M8 32h24" />
        <path d="M12 32c1-6 4-9 8-9s7 3 8 9" />
        <circle cx="16" cy="9" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="23" cy="13" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="19" cy="18" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="26" cy="7" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === "bloom" && (
      <>
        <path d="M20 33V16" />
        <path d="M20 24c-5 0-7-3-7-7 4 0 7 2 7 7Z" />
        <path d="M20 21c4-1 6-4 5-8-4 1-6 4-5 8Z" />
        <circle cx="20" cy="12" r="4" />
        <circle cx="20" cy="12" r="1.2" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === "trail" && (
      <>
        <path d="M7 27c4-11 8 5 12-4s6 7 14-6" stroke-opacity="0.3" stroke-width="4" />
        <path d="M7 27c4-11 8 5 12-4s6 7 14-6" />
      </>
    )
  }
  {
    slug === "ripple" && (
      <>
        <path d="M6 24a14 8 0 0 0 28 0" stroke-opacity="0.3" />
        <path d="M11 20a9 5 0 0 0 18 0" stroke-opacity="0.55" />
        <path d="M15 16a5 3 0 0 0 10 0" />
        <path d="M20 12V6" />
        <circle cx="20" cy="6" r="1.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === "chain" && (
      <>
        <rect x="9" y="6" width="22" height="28" rx="2" stroke-opacity="0.35" />
        <circle cx="15" cy="28" r="3.4" />
        <circle cx="25" cy="28" r="3.4" />
        <circle cx="20" cy="20" r="3.4" />
        <circle cx="20" cy="11" r="3.4" stroke-opacity="0.45" />
        <path d="M20 14.5v2M20 23.5v1.2" stroke-opacity="0.45" />
      </>
    )
  }
  {
    slug === "memory" && (
      <>
        <rect x="7" y="10" width="13" height="19" rx="2" stroke-opacity="0.4" />
        <rect x="21" y="10" width="13" height="19" rx="2" />
        <path d="M24.5 19.5h6" />
        <path d="M27.5 16.5v6" />
      </>
    )
  }
  {
    slug === "jigsaw" && (
      <>
        <path d="M9 9h9a3 3 0 0 1 6 0h7v7a3 3 0 0 1 0 6v9h-9a3 3 0 0 0-6 0H9V9Z" />
        <path d="M18 22a3 3 0 0 0-3-3H9" stroke-opacity="0.4" />
      </>
    )
  }
  {
    slug === "queens" && (
      <>
        <rect x="7" y="7" width="26" height="26" rx="2" stroke-opacity="0.4" />
        <path d="M7 15.7h26M7 24.3h26M15.7 7v26M24.3 7v26" stroke-opacity="0.2" />
        <path d="M16 26h8l1.5-8-3.5 3-2-5-2 5-3.5-3L16 26Z" />
      </>
    )
  }
</svg>

<style>
  .game-mark {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
