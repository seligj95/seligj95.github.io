---
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<span class="view-count" data-path={path} hidden>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
    <circle cx="12" cy="12" r="3" />
  </svg>
  <span class="count-text"></span>
</span>

<style>
  .view-count {
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .view-count:not([hidden]) {
    display: inline-flex;
  }
</style>

<script>
  const elements = document.querySelectorAll<HTMLElement>(".view-count");

  if (elements.length > 0) {
    const fetches = Array.from(elements).map(async (el) => {
      const path = el.dataset.path;
      if (!path) return;

      // Keep the count and its separator hidden until a real count resolves,
      // so no "— views" placeholder or wrong grammar ever flashes.
      const prev = el.previousElementSibling;
      const sep = prev?.classList.contains("sep")
        ? (prev as HTMLElement)
        : null;
      if (sep) sep.style.display = "none";

      try {
        const res = await fetch(
          `https://jordanselig.goatcounter.com/counter/${encodeURIComponent(path)}.json`
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        // GoatCounter formats counts >= 1000 with a thousands separator
        // (a U+202F narrow no-break space), e.g. "1 293". Strip any
        // non-digit characters before parsing so large counts don't
        // become NaN and fall back to 0.
        const count = Number(String(data.count).replace(/[^0-9]/g, "")) || 0;
        const countText = el.querySelector(".count-text");
        if (countText) {
          countText.textContent = `${count} ${count === 1 ? "view" : "views"}`;
        }
        el.hidden = false;
        if (sep) sep.style.display = "";
      } catch {
        // Leave the count hidden and the separator collapsed.
      }
    });

    Promise.all(fetches);
  }
</script>
