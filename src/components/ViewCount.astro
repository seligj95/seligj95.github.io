---
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<span class="view-count" data-path={path}>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
    <circle cx="12" cy="12" r="3" />
  </svg>
  <span class="count-text">&mdash; views</span>
</span>

<style>
  .view-count {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>

<script>
  const elements = document.querySelectorAll<HTMLElement>(".view-count");

  if (elements.length > 0) {
    const fetches = Array.from(elements).map(async (el) => {
      const path = el.dataset.path;
      if (!path) return;

      try {
        const res = await fetch(
          `https://jordanselig.goatcounter.com/counter/${encodeURIComponent(path)}.json`
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const countText = el.querySelector(".count-text");
        if (countText) {
          countText.textContent = `${data.count} views`;
        }
      } catch {
        el.style.display = "none";

        // Also hide the preceding separator if present
        const prev = el.previousElementSibling;
        if (prev?.classList.contains("sep")) {
          (prev as HTMLElement).style.display = "none";
        }
      }
    });

    Promise.all(fetches);
  }
</script>
