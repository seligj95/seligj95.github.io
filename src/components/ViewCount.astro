---
interface Props {
  path: string;
  externalUrl?: string;
}

const { path, externalUrl } = Astro.props;
let techCommunityMessageId: string | undefined;

if (externalUrl) {
  const url = new URL(externalUrl);
  if (url.hostname.toLowerCase() === "techcommunity.microsoft.com") {
    techCommunityMessageId = url.pathname.match(/\/(\d+)\/?$/)?.[1];
  }
}
---

<span
  class="view-count"
  data-path={path}
  data-tech-community-url={techCommunityMessageId ? externalUrl : undefined}
  data-tech-community-id={techCommunityMessageId}
  hidden
>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
    <circle cx="12" cy="12" r="3" />
  </svg>
  <span class="count-text"></span>
</span>

<style>
  .view-count {
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .view-count:not([hidden]) {
    display: inline-flex;
  }
</style>

<script>
  import { VIEW_API_BASE } from "../lib/api";

  const elements = document.querySelectorAll<HTMLElement>(".view-count");

  if (elements.length > 0) {
    const fetches = Array.from(elements).map(async (el) => {
      const path = el.dataset.path;
      if (!path) return;

      // Keep the count and its separator hidden until a real count resolves,
      // so no "— views" placeholder or wrong grammar ever flashes.
      const prev = el.previousElementSibling;
      const sep = prev?.classList.contains("sep")
        ? (prev as HTMLElement)
        : null;
      if (sep) sep.style.display = "none";

      try {
        const techCommunityUrl = el.dataset.techCommunityUrl;
        const techCommunityId = el.dataset.techCommunityId;
        const endpoint =
          techCommunityUrl && techCommunityId
            ? `${VIEW_API_BASE}/api/views/tech-community/${techCommunityId}?url=${encodeURIComponent(techCommunityUrl)}`
            : `https://jordanselig.goatcounter.com/counter/${encodeURIComponent(path)}.json`;
        const res = await fetch(endpoint, { signal: AbortSignal.timeout(20_000) });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as { count?: unknown };
        // GoatCounter may format large counts with narrow no-break spaces.
        if (typeof data.count !== "number" && typeof data.count !== "string") {
          throw new Error("Invalid view count");
        }
        const digits = String(data.count).replace(/[^0-9]/g, "");
        if (!digits) throw new Error("Invalid view count");
        const count = Number(digits);
        if (!Number.isSafeInteger(count) || count < 0) {
          throw new Error("Invalid view count");
        }
        const countText = el.querySelector(".count-text");
        if (countText) {
          countText.textContent = `${count} ${count === 1 ? "view" : "views"}`;
        }
        el.hidden = false;
        if (sep) sep.style.display = "";
      } catch {
        // Leave the count hidden and the separator collapsed.
      }
    });

    Promise.all(fetches);
  }
</script>
