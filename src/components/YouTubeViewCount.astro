---
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;
---

<span class="youtube-view-count" data-video-id={videoId} hidden>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
    <circle cx="12" cy="12" r="3" />
  </svg>
  <span class="count-text"></span>
</span>

<style>
  .youtube-view-count {
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .youtube-view-count:not([hidden]) {
    display: inline-flex;
  }
</style>

<script>
  interface ShieldsResponse {
    message?: string;
  }

  interface MixernoResponse {
    counts?: Array<{
      value?: string;
      count?: number;
    }>;
  }

  const isViewCount = (value: string) =>
    /^\d+(?:\.\d+)?[kMGTPE]?$/.test(value);

  async function fetchViewCount(videoId: string): Promise<string> {
    const shieldsResponse = await fetch(
      `https://img.shields.io/youtube/views/${encodeURIComponent(videoId)}.json`
    );
    if (!shieldsResponse.ok) {
      throw new Error(`Shields returned HTTP ${shieldsResponse.status}`);
    }

    const shieldsData = (await shieldsResponse.json()) as ShieldsResponse;
    if (shieldsData.message && isViewCount(shieldsData.message)) {
      return shieldsData.message;
    }

    const fallbackResponse = await fetch(
      `https://mixerno.space/api/youtube-video-counter/user/${encodeURIComponent(videoId)}`
    );
    if (!fallbackResponse.ok) {
      throw new Error(`Mixerno returned HTTP ${fallbackResponse.status}`);
    }

    const fallbackData = (await fallbackResponse.json()) as MixernoResponse;
    const count = fallbackData.counts?.find(
      (entry) => entry.value === "views"
    )?.count;
    if (typeof count !== "number" || !Number.isFinite(count)) {
      throw new Error("View count missing from fallback response");
    }

    return new Intl.NumberFormat("en-US", {
      notation: "compact",
      maximumFractionDigits: 1,
    }).format(count);
  }

  const elements = document.querySelectorAll<HTMLElement>(
    ".youtube-view-count"
  );

  const fetches = Array.from(elements).map(async (element) => {
    const videoId = element.dataset.videoId;
    if (!videoId) return;

    try {
      const count = await fetchViewCount(videoId);

      const countText = element.querySelector(".count-text");
      if (countText) {
        countText.textContent = `${count} ${count === "1" ? "view" : "views"}`;
      }
      element.hidden = false;
    } catch {
      // Leave the count hidden when the live YouTube statistic is unavailable.
    }
  });

  Promise.all(fetches);
</script>
