---
const RESULTS_PER_PAGE = 10;
---

<div class="blog-search">
  <div class="search-input-wrapper">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      type="text"
      id="blog-search-input"
      placeholder="Search posts…"
      autocomplete="off"
      aria-label="Search blog posts"
    />
    <button id="search-clear" class="search-clear" aria-label="Clear search" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
    </button>
  </div>
  <div id="search-results" class="search-results" hidden></div>
  <nav id="search-pagination" class="pagination" aria-label="Search results pagination" hidden></nav>
</div>

<style>
  .blog-search {
    margin-bottom: 1.5rem;
  }
  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  #blog-search-input {
    width: 100%;
    padding: 0.625rem 2.5rem 0.625rem 2.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #blog-search-input::placeholder {
    color: var(--text-muted);
  }
  #blog-search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }
  .search-clear {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    border-radius: 0.25rem;
  }
  .search-clear:hover {
    color: var(--text);
  }
  .search-results {
    margin-top: 0.5rem;
  }
  .search-results :global(.search-result-item) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1rem 0.5rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 0.375rem;
    transition: background 0.15s ease;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .search-results :global(.search-result-item:first-child) {
    border-top: 1px solid var(--border);
  }
  .search-results :global(.search-result-item:hover) {
    background: var(--surface);
  }
  .search-results :global(.search-result-item:hover .result-title) {
    color: var(--accent);
  }
  .search-results :global(.result-info) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .search-results :global(.result-title) {
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .search-results :global(.result-excerpt) {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results :global(.result-excerpt mark) {
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: 0.125rem;
    padding: 0 0.125rem;
  }
  .search-results :global(.no-results) {
    padding: 1.5rem 0.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .pagination :global(a),
  .pagination :global(button) {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0;
  }
  .pagination :global(a:hover),
  .pagination :global(button:hover) {
    text-decoration: underline;
  }
  .pagination :global(.page-info) {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>

<script define:vars={{ RESULTS_PER_PAGE }}>
  let pagefind = null;
  let allResults = [];
  let currentPage = 1;
  let debounceTimer = null;

  const input = document.getElementById('blog-search-input');
  const clearBtn = document.getElementById('search-clear');
  const resultsContainer = document.getElementById('search-results');
  const paginationContainer = document.getElementById('search-pagination');
  const defaultList = document.getElementById('blog-default-list');

  async function initPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      pagefind = null;
    }
    return pagefind;
  }

  function showSearchResults() {
    resultsContainer.hidden = false;
    if (defaultList) defaultList.style.display = 'none';
  }

  function hideSearchResults() {
    resultsContainer.hidden = true;
    paginationContainer.hidden = true;
    if (defaultList) defaultList.style.display = '';
  }

  async function renderPage(page) {
    currentPage = page;
    const start = (page - 1) * RESULTS_PER_PAGE;
    const end = start + RESULTS_PER_PAGE;
    const pageResults = allResults.slice(start, end);

    const items = await Promise.all(pageResults.map(r => r.data()));

    if (items.length === 0) {
      resultsContainer.innerHTML = '<p class="no-results">No posts found.</p>';
      paginationContainer.hidden = true;
      return;
    }

    resultsContainer.innerHTML = items.map(item => {
      const title = item.meta?.title || 'Untitled';
      const excerpt = item.excerpt || item.meta?.description || '';
      return `
        <a href="${item.url}" class="search-result-item">
          <div class="result-info">
            <span class="result-title">${title}</span>
            <span class="result-excerpt">${excerpt}</span>
          </div>
        </a>
      `;
    }).join('');

    const totalPages = Math.ceil(allResults.length / RESULTS_PER_PAGE);
    if (totalPages > 1) {
      paginationContainer.hidden = false;
      paginationContainer.innerHTML = `
        ${page > 1 ? '<button data-page="' + (page - 1) + '">← Previous</button>' : '<span></span>'}
        <span class="page-info">Page ${page} of ${totalPages}</span>
        ${page < totalPages ? '<button data-page="' + (page + 1) + '">Next →</button>' : '<span></span>'}
      `;
      paginationContainer.querySelectorAll('button[data-page]').forEach(btn => {
        btn.addEventListener('click', () => renderPage(parseInt(btn.dataset.page)));
      });
    } else {
      paginationContainer.hidden = true;
    }
  }

  async function doSearch(query) {
    const pf = await initPagefind();
    if (!pf) return;

    if (!query.trim()) {
      hideSearchResults();
      allResults = [];
      return;
    }

    const search = await pf.search(query);
    allResults = search.results;
    currentPage = 1;
    showSearchResults();
    await renderPage(1);
  }

  input.addEventListener('input', () => {
    clearBtn.hidden = !input.value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => doSearch(input.value), 200);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.hidden = true;
    hideSearchResults();
    allResults = [];
    input.focus();
  });
</script>
