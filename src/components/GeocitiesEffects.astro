<!--
  GeoCities Effects — only active when data-theme="geocities"
  Adds: marquee banner, floating GIFs, cursor sparkle trail, fake visitor counter,
  guestbook link, and MIDI joke text.
-->

<div id="geocities-effects" class="geocities-effects" aria-hidden="true">
  <!-- Marquee banner -->
  <div class="gc-marquee-bar">
    <span class="gc-marquee-text">
      🚧 UNDER CONSTRUCTION 🚧 &nbsp;&bull;&nbsp; Welcome to my GeoCities page!! 🌟 &nbsp;&bull;&nbsp;
      Best viewed in Netscape Navigator at 800x600 &nbsp;&bull;&nbsp; 💾 FREE MIDI DOWNLOADS 💾 &nbsp;&bull;&nbsp;
      Sign my Guestbook!! 📖 &nbsp;&bull;&nbsp; You are visitor #
      <span class="gc-counter">008,374</span> &nbsp;&bull;&nbsp;
      ♪ Now playing: canyon.mid ♪ &nbsp;&bull;&nbsp; 🔥 HOT LINKS 🔥 &nbsp;&bull;&nbsp;
    </span>
  </div>
</div>

<style>
  .geocities-effects {
    display: none;
  }

  :global([data-theme="geocities"]) .geocities-effects {
    display: block;
  }

  /* Marquee bar — sits above content flow, not fixed over the nav */
  .gc-marquee-bar {
    position: relative;
    z-index: 101;
    background: linear-gradient(90deg, #ff0000, #ff8800, #ffff00, #00ff00, #00ffff, #0088ff, #ff00ff, #ff0000);
    padding: 4px 0;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 2px solid #000;
    contain: paint;
  }

  .gc-marquee-text {
    display: inline-block;
    animation: geocities-marquee 20s linear infinite;
    color: #000;
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    font-weight: bold;
    font-size: 0.85rem;
    text-shadow: 1px 1px 0 #fff;
    will-change: transform;
  }

  .gc-counter {
    font-family: "Courier New", monospace;
    background: #000;
    color: #00ff00;
    padding: 0 4px;
    border: 1px inset #888;
  }
</style>

<script>
  const RETRO_DECORATIONS = ["🚧", "🌐", "🔥", "⭐", "💾", "📧", "🏗️", "💿", "🎵", "👷", "🌈", "💥"];
  const MAX_SPARKLES = 20;
  const MIN_SPARKLE_INTERVAL_MS = 40;

  let decoElements: HTMLElement[] = [];
  const sparkles: HTMLElement[] = [];
  let sparkleFrame: number | null = null;
  let latestPointer: { x: number; y: number } | null = null;
  let lastSparkleAt = 0;
  let active = false;

  function isGeocities(): boolean {
    return document.documentElement.getAttribute("data-theme") === "geocities";
  }

  function createSparkle(x: number, y: number) {
    if (sparkles.length >= MAX_SPARKLES) return;

    const sparkle = document.createElement("span");
    sparkle.textContent = ["✦", "✧", "★", "⋆", "✶", "❋", "✺"][Math.floor(Math.random() * 7)];
    sparkle.style.cssText = `
      position: fixed;
      left: ${x}px;
      top: ${y}px;
      pointer-events: none;
      z-index: 99999;
      font-size: ${10 + Math.random() * 14}px;
      color: ${["#ff0000", "#ffff00", "#00ff00", "#00ffff", "#ff00ff", "#ff8800"][Math.floor(Math.random() * 6)]};
      animation: geocities-sparkle-fade 0.8s ease-out forwards;
      text-shadow: 0 0 6px currentColor;
      contain: paint;
      will-change: transform, opacity;
    `;
    document.body.appendChild(sparkle);
    sparkles.push(sparkle);
    setTimeout(() => {
      sparkle.remove();
      const idx = sparkles.indexOf(sparkle);
      if (idx > -1) sparkles.splice(idx, 1);
    }, 800);
  }

  function onMouseMove(e: MouseEvent) {
    latestPointer = { x: e.clientX, y: e.clientY };
    if (sparkleFrame !== null) return;

    sparkleFrame = requestAnimationFrame((now) => {
      sparkleFrame = null;
      if (!isGeocities() || !latestPointer || now - lastSparkleAt < MIN_SPARKLE_INTERVAL_MS) return;

      createSparkle(
        latestPointer.x + (Math.random() - 0.5) * 20,
        latestPointer.y + (Math.random() - 0.5) * 20
      );
      lastSparkleAt = now;
    });
  }

  function spawnFloatingDecos() {
    removeFloatingDecos();
    const count = 5 + Math.floor(Math.random() * 4);
    for (let i = 0; i < count; i++) {
      const el = document.createElement("span");
      el.textContent = RETRO_DECORATIONS[Math.floor(Math.random() * RETRO_DECORATIONS.length)];
      const size = 28 + Math.random() * 32;
      el.style.cssText = `
        position: fixed;
        font-size: ${size}px;
        left: ${Math.random() * 85}vw;
        top: ${10 + Math.random() * 75}vh;
        z-index: 9998;
        pointer-events: none;
        opacity: 0.7;
        filter: drop-shadow(0 0 6px #ff00ff);
        animation: geocities-float-spin ${3 + Math.random() * 5}s linear ${-Math.random() * 5}s infinite;
        contain: paint;
        will-change: transform;
      `;
      document.body.appendChild(el);
      decoElements.push(el);
    }
  }

  function removeFloatingDecos() {
    for (const el of decoElements) el.remove();
    decoElements = [];
  }

  function activate() {
    if (active) return;
    active = true;
    document.addEventListener("mousemove", onMouseMove, { passive: true });
    spawnFloatingDecos();
  }

  function deactivate() {
    active = false;
    document.removeEventListener("mousemove", onMouseMove);
    if (sparkleFrame !== null) {
      cancelAnimationFrame(sparkleFrame);
      sparkleFrame = null;
    }
    latestPointer = null;
    removeFloatingDecos();
    for (const s of sparkles) s.remove();
    sparkles.length = 0;
  }

  // Watch for theme changes
  const observer = new MutationObserver(() => {
    if (isGeocities()) {
      activate();
    } else {
      deactivate();
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Initial check
  if (isGeocities()) activate();
</script>
