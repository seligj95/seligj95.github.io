{
  // The API stands alone. Without this it walks up and finds the site's config,
  // which extends an Astro preset that only exists in the site's node_modules —
  // fine locally, but the API's own CI job never installs those.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // Node strips the types rather than compiling, so nothing is ever emitted.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  // A file left out of this list is treated as belonging to whatever config is
  // found further up, so every directory here has to be listed.
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
